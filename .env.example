# IoT Factory Monitor - environment configuration
# Copy to .env (`cp .env.example .env`, or `make up` does it for you).
#
# !!! DEVELOPMENT DEFAULTS ONLY !!!
# Every value marked "change-me" MUST be replaced before exposing this stack
# on any network you do not fully control. Never commit your real .env.

# ---- TimescaleDB ----
POSTGRES_USER=factory
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=factory
# Read-only role used by Grafana (created on first DB init only)
GRAFANA_DB_USER=grafana_reader
GRAFANA_DB_PASSWORD=change-me-grafana-reader

# ---- MQTT (Mosquitto) ----
# Usernames are fixed (ingestor / simulator, see mosquitto/acl); set passwords here.
MQTT_INGESTOR_PASSWORD=change-me-mqtt-ingestor
MQTT_SIMULATOR_PASSWORD=change-me-mqtt-simulator

# ---- Grafana ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin

# ---- Simulator ----
SIM_LINES=2
SIM_MACHINES_PER_LINE=3
PUBLISH_INTERVAL_S=1.0
# Fault frequency multiplier (1.0 = one fault per machine every ~25 min on average)
SIM_FAULT_RATE=1.0
# Ideal cycle time per part in seconds; should match machines.ideal_cycle_time_s (DB default 2.0)
IDEAL_CYCLE_TIME_S=2.0
# Set an integer for reproducible runs
SIM_SEED=

# ---- Ingestor ----
BATCH_SIZE=500
FLUSH_INTERVAL_S=1.0
MAX_BUFFER=100000
LOG_LEVEL=INFO

# ---- Published host ports (bound to 127.0.0.1 only) ----
GRAFANA_PORT=3000
MQTT_PORT=1883
POSTGRES_PORT=5432
INGESTOR_HEALTH_PORT=8080
